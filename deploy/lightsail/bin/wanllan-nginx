#!/usr/bin/env bash
# Écrit la configuration Nginx du site.
#   wanllan-nginx http    avant le certificat : le site répond en http (et sur l'IP)
#   wanllan-nginx https   après le certificat : tout passe en https sur le domaine
set -euo pipefail
source /etc/wanllan/deploy.conf
[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"

MODE="${1:-}"
SITE=/etc/nginx/sites-available/wanllan
CERT="/etc/letsencrypt/live/$DOMAIN"
ACME='location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }'

# Le certificat couvre www seulement s'il a été demandé (wanllan-https le décide).
WWW=0
if [[ -f "$CERT/cert.pem" ]] && openssl x509 -in "$CERT/cert.pem" -noout -ext subjectAltName 2>/dev/null | grep -q "DNS:www.$DOMAIN"; then
    WWW=1
fi

case "$MODE" in
http)
    cat > "$SITE" <<EOF
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name $DOMAIN www.$DOMAIN _;
    $ACME
    include snippets/wanllan-app.conf;
}
EOF
    ;;
https)
    [[ -f "$CERT/fullchain.pem" ]] || { echo "Pas de certificat pour $DOMAIN : lancez sudo wanllan-https" >&2; exit 1; }
    SSL="ssl_certificate $CERT/fullchain.pem;
    ssl_certificate_key $CERT/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;"
    {
        cat <<EOF
# Tout le trafic http part vers https://$DOMAIN (sauf la vérification du certificat).
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    $ACME
    location / { return 301 https://$DOMAIN\$request_uri; }
}
EOF
        if [[ $WWW -eq 1 ]]; then
            cat <<EOF
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.$DOMAIN;
    $SSL
    return 301 https://$DOMAIN\$request_uri;
}
EOF
        fi
        cat <<EOF
server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name $DOMAIN;
    $SSL
    add_header Strict-Transport-Security "max-age=31536000" always;
    include snippets/wanllan-app.conf;
}
EOF
    } > "$SITE"
    ;;
*)
    echo "Usage : wanllan-nginx http|https" >&2
    exit 2
    ;;
esac

ln -sfn "$SITE" /etc/nginx/sites-enabled/wanllan
nginx -t -q
systemctl reload nginx
echo "Nginx : mode $MODE."
